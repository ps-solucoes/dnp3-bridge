# Multi-stage Docker build for BeagleBone Black (armhf / arm32v7)
# Uses Debian Trixie (13) to match the target BBB OS.

FROM arm32v7/debian:trixie AS builder

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ca-certificates \
    libgrpc++-dev \
    libprotobuf-dev \
    protobuf-compiler-grpc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Configure and build (release mode, skip tests)
RUN cmake --preset release -Wno-dev \
    && cmake --build --preset release --target dnp3-bridge dnp3-master-sim --parallel $(nproc)

# --- Minimal runtime image (optional, for deployment) ---
FROM arm32v7/debian:trixie-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgrpc++1.65 \
    libprotobuf38 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/build/release/dnp3-bridge /usr/local/bin/dnp3-bridge

ENTRYPOINT ["dnp3-bridge"]
